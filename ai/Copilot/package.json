{
  "name": "copilot-desktop",
  "version": "1.0.1",
  "description": "Unofficial Electron desktop wrapper for Microsoft Copilot.",
  "main": "main.js",
  "homepage": "https://copilot.com",
  "author": { "name": "Linux Desktop Apps contributors", "email": "maintainers@example.com" },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "validate": "node --check main.js && node --check preload.js",
    "build": "electron-builder --linux",
    "build:linux": "electron-builder --linux AppImage deb",
    "package": "npm run build:linux"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ai.copilot.desktop",
    "productName": "Copilot",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "Microsoft_Copilot_logo_PNG_(1).png", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "Microsoft_Copilot_logo_PNG_(1).png",
      "category": "Network;Chat;",
      "synopsis": "Microsoft Copilot AI desktop app",
      "artifactName": "Copilot-${version}-${arch}.${ext}"
    }
  },
  "engines": { "node": ">=22.12.0" }
}
