#!/bin/sh
# GitHub Desktop launcher with virtual display support

# If we have a display, use it directly
if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
  export GDK_BACKEND=x11
  export GTK_A11Y=none
  exec /app/lib/github-desktop/electron/electron --no-sandbox --disable-gpu --disable-software-rasterizer --ozone-platform=x11 /app/lib/github-desktop "$@"
fi

# No display available - try to use xvfb-run from the host system
# Look in common paths
for xvfb_run in /usr/bin/xvfb-run /bin/xvfb-run /usr/local/bin/xvfb-run; do
  if [ -x "$xvfb_run" ]; then
    echo "Using virtual display via xvfb-run..."
    export DISPLAY=:99
    exec "$xvfb_run" -a -s "-screen 0 1920x1080x24" /app/lib/github-desktop/electron/electron --no-sandbox --disable-gpu --disable-software-rasterizer /app/lib/github-desktop "$@"
  fi
done

# If xvfb-run not found, run with QT offscreen platform or simple fallback
echo "Running GitHub Desktop without display... Installing xvfb may improve compatibility."
exec /app/lib/github-desktop/electron/electron --no-sandbox --disable-gpu --disable-software-rasterizer /app/lib/github-desktop "$@"



