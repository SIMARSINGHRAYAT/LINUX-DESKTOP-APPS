[Desktop Entry]
Name=GitHub
Comment=Unofficial GitHub wrapper for Linux
Exec=/home/$USER/.local/bin/github-desktop %U
Icon=io.github.example.GitHubDesktop
Terminal=false
Type=Application
Categories=Development;Network;
StartupNotify=true
StartupWMClass=GitHub
Keywords=GitHub;development;repositories;
X-Flatpak=io.github.example.GitHubDesktop