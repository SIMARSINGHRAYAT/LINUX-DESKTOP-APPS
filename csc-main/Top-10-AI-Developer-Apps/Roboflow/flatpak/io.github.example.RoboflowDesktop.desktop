[Desktop Entry]
Name=Roboflow Desktop
Comment=Unofficial Roboflow desktop wrapper for Linux
Exec=roboflow-desktop
Icon=io.github.example.RoboflowDesktop
Terminal=false
Type=Application
Categories=Development;Graphics;
