{
  "name": "microsoft-azure-desktop",
  "version": "1.0.0",
  "description": "Unofficial Electron wrapper around Microsoft's official Azure portal.",
  "main": "main.js",
  "homepage": "https://portal.azure.com/",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "validate": "node --check main.js && node --check preload.js",
    "build": "electron-builder --linux",
    "build:linux": "electron-builder --linux AppImage deb",
    "package": "npm run build:linux"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.0.12"
  },
  "engines": { "node": ">=22.12.0" },
  "build": {
    "appId": "com.microsoft.desktop.azure",
    "productName": "Microsoft Azure",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "assets/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network;Office;",
      "icon": "assets/icons",
      "synopsis": "Microsoft Azure desktop wrapper",
      "artifactName": "Microsoft-Azure-${version}-${arch}.${ext}"
    }
  }
}
